# =====================================================================
# 校园论坛（ibb-school-hole）环境变量示例
# 生产环境请存放于 /opt/ibb-school-hole/.env（严禁提交任何真实密钥到仓库）
# =====================================================================

# --- 宿主机端口映射（仅监听 127.0.0.1，严禁复用 3000 / 3010） ---
HOLE_PORT=3020

# --- 运行模式与数据库路径 ---
NODE_ENV=production
FORUM_DB_PATH=/app/data/forum.db
TRUST_PROXY_HEADERS=true

# --- 一期总闸门（默认全关；人机验证与 AI 审核接入后方可置为 true） ---
FEATURE_AUTH_ENABLED=false
FEATURE_POSTING_ENABLED=false

# --- 核心安全密钥（当开启任一总闸门时，生产环境强制要求至少 32 位随机高熵字符串） ---
# 生成参考：openssl rand -hex 32
SESSION_SECRET=
ANONYMOUS_HMAC_SECRET=
IP_HASH_SALT=
FORM_SIGNING_SECRET=

# --- 二期可插拔人机验证适配器（disabled | turnstile | altcha） ---
CAPTCHA_PROVIDER=disabled
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- 二期可插拔 AI 内容审核适配器（disabled | openai_compatible） ---
AI_MODERATION_PROVIDER=disabled
AI_MODERATION_API_URL=
AI_MODERATION_API_KEY=
AI_MODERATION_MODEL=
